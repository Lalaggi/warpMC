From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WarpMC Team <warpmc@local>
Date: Thu, 8 Oct 2026 17:33:27 +0100
Subject: [PATCH] WarpMC: Add FakeServerPlayer support to CraftEntity +
 CraftFakePlayer wrapper


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index 71d14d016e97e3fb93d2c10862afd0c314b9a367..36defc0da8b54e1f044f7ad472fc17e483d155be 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -137,6 +137,12 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
     public static <T extends Entity> CraftEntity getEntity(CraftServer server, T entity) {
         Preconditions.checkArgument(entity != null, "Unknown entity");
 
+        // WarpMC start - FakeServerPlayer
+        if (entity instanceof net.minecraft.server.level.FakeServerPlayer fakePlayer) {
+            return new CraftFakePlayer(server, fakePlayer);
+        }
+        // WarpMC end - FakeServerPlayer
+
         // Special case human, since bukkit use Player interface for ...
         if (entity instanceof net.minecraft.world.entity.player.Player && !(entity instanceof ServerPlayer)) {
             return new CraftHumanEntity(server, (net.minecraft.world.entity.player.Player) entity);
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftFakePlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftFakePlayer.java
new file mode 100644
index 0000000000000000000000000000000000000000..e07bf640fc2809f0cee7f3b8ec281ad91851e9f7
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftFakePlayer.java
@@ -0,0 +1,105 @@
+package org.bukkit.craftbukkit.entity;
+
+import net.minecraft.server.level.FakeServerPlayer;
+import org.bukkit.craftbukkit.CraftServer;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+import org.purpurmc.purpur.player.FakePlayer;
+
+import java.time.Instant;
+import java.util.UUID;
+
+/**
+ * CraftBukkit wrapper for {@link net.minecraft.server.level.FakeServerPlayer}.
+ * <p>
+ * Implements the Purpur API {@link FakePlayer} interface, allowing
+ * plugins to use {@code player instanceof FakePlayer} checks.
+ */
+public class CraftFakePlayer extends CraftPlayer implements FakePlayer {
+
+    public CraftFakePlayer(CraftServer server, net.minecraft.server.level.FakeServerPlayer handle) {
+        super(server, handle);
+    }
+
+    @Override
+    public net.minecraft.server.level.FakeServerPlayer getHandle() {
+        return (net.minecraft.server.level.FakeServerPlayer) entity;
+    }
+
+    // --- FakePlayer API ---
+
+    @Override
+    public boolean isFake() {
+        return true;
+    }
+
+    @Override
+    public @NotNull UUID getOwnerUuid() {
+        return getHandle().getOwnerUuid();
+    }
+
+    @Override
+    public long getTimeoutMinutes() {
+        return getHandle().getTimeoutMinutes();
+    }
+
+    @Override
+    public void setTimeoutMinutes(long minutes) {
+        getHandle().setTimeoutMinutes(minutes);
+    }
+
+    @Override
+    public @Nullable String getReason() {
+        return getHandle().getReason();
+    }
+
+    @Override
+    public void setReason(@Nullable String reason) {
+        getHandle().setReason(reason);
+    }
+
+    @Override
+    public @Nullable Instant getSpawnTime() {
+        return getHandle().getSpawnTime();
+    }
+
+    @Override
+    public boolean isExpired() {
+        return getHandle().isExpired();
+    }
+
+    @Override
+    public boolean isDamageDisabled() {
+        return getHandle().isDamageDisabled();
+    }
+
+    @Override
+    public void setDamageDisabled(boolean disabled) {
+        getHandle().setDamageDisabled(disabled);
+    }
+
+    @Override
+    public boolean isHidden() {
+        return getHandle().isHidden();
+    }
+
+    @Override
+    public void setHidden(boolean hidden) {
+        getHandle().setHidden(hidden);
+    }
+
+    @Override
+    public boolean isResetHealthOnDeath() {
+        return getHandle().isResetHealthOnDeath();
+    }
+
+    @Override
+    public void setResetHealthOnDeath(boolean reset) {
+        getHandle().setResetHealthOnDeath(reset);
+    }
+
+    @Override
+    public void remove() {
+        getHandle().remove();
+    }
+}
